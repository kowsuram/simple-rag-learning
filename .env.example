# PostgreSQL / pgvector Database Configuration
# Set DATABASE_URL to use a hosted database such as Neon; it takes precedence over DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=healthcaredb
DB_USER=postgres
DB_PASSWORD=postgrespassword

# AI Provider: use "ollama" locally or "cloudflare" for Workers AI
AI_PROVIDER=ollama

# Ollama Configuration (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Cloudflare Workers AI (used when AI_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
# Defaults: @cf/meta/llama-3.2-3b-instruct and @cf/baai/bge-base-en-v1.5

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# RAG Ingestion & Retrieval Configuration
CHUNK_SIZE=450
CHUNK_OVERLAP=80
TOP_K=3
